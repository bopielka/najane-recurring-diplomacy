<?xml version="1.0" encoding="utf-8"?>
<!--
    version on <Mod> must be an integer >= 1: it is parsed as an int, and version="0.1" lands as 0,
    which the game silently refuses to apply. The human-readable version is <Properties><Version>.
-->
<Mod id="najane-recurring-diplomacy" version="1"
    xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_NAJANE_RECURRING_NAME</Name>
        <Version>1.0</Version>
        <Description>LOC_MOD_NAJANE_RECURRING_DESCRIPTION</Description>
        <Authors>Najane</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <ShowInBrowser>1</ShowInBrowser>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="najane-recurring-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/InGameText.xml</Item>
                    <Item locale="de_DE">text/de_DE/InGameText.xml</Item>
                    <Item locale="es_ES">text/es_ES/InGameText.xml</Item>
                    <Item locale="fr_FR">text/fr_FR/InGameText.xml</Item>
                    <Item locale="it_IT">text/it_IT/InGameText.xml</Item>
                    <Item locale="ja_JP">text/ja_JP/InGameText.xml</Item>
                    <Item locale="ko_KR">text/ko_KR/InGameText.xml</Item>
                    <Item locale="pl_PL">text/pl_PL/InGameText.xml</Item>
                    <Item locale="pt_BR">text/pt_BR/InGameText.xml</Item>
                    <!-- ru_RU holds UKRAINIAN text; see the note in the file. -->
                    <Item locale="ru_RU">text/ru_RU/InGameText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_Hans_CN/InGameText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_Hant_HK/InGameText.xml</Item>
                </UpdateText>
                <!--
                    The sync toggle's icon, served as fs://game/najane-recurring-diplomacy/icons/…,
                    which only resolves for files registered here. A PNG because an SVG data: URI
                    draws nothing in this engine; regenerate with tools/make-icons.py.
                -->
                <ImportFiles>
                    <Item>icons/sync.png</Item>
                </ImportFiles>
                <UIScripts>
                    <Item>ui/recurring-diplomacy.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <!--
            No shell group yet. When the options module lands (ui/options/), it has to be
            registered in a scope="shell" group as well, or its rows vanish from the main
            menu's Options screen - see documentation/02-architecture.md.
        -->
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModInfoText.xml</File>
        <File>text/de_DE/ModInfoText.xml</File>
        <File>text/es_ES/ModInfoText.xml</File>
        <File>text/fr_FR/ModInfoText.xml</File>
        <File>text/it_IT/ModInfoText.xml</File>
        <File>text/ja_JP/ModInfoText.xml</File>
        <File>text/ko_KR/ModInfoText.xml</File>
        <File>text/pl_PL/ModInfoText.xml</File>
        <File>text/pt_BR/ModInfoText.xml</File>
        <File>text/ru_RU/ModInfoText.xml</File>
        <File>text/zh_Hans_CN/ModInfoText.xml</File>
        <File>text/zh_Hant_HK/ModInfoText.xml</File>
    </LocalizedText>
</Mod>
